@using Repositories.Models
@{
    Layout = "~/Views/Shared/_StudentDashboardLayout.cshtml";
    var materials = Model as List<EduProj.Models.vm_Material> ?? new List<EduProj.Models.vm_Material>();
    var subjects = ViewBag.Subjects as List<t_subject> ?? new List<t_subject>();
    ViewBag.Sub = subjects;;
    var teachers = ViewBag.Teachers as List<t_Teacher> ?? new List<t_Teacher>();
    
}

<!-- Multi-Select Dropdown for Subjects -->
<div class="form-group">
    <label for="subjectDropdown" class="font-weight-bold">Select Subjects:</label>
    <select id="subjectDropdown" multiple="multiple" class="form-control">
        @foreach (var subject in subjects)
        {
            <option value="@subject.c_subid">@subject.c_subjectname</option>
        }
    </select>
</div>

<!-- Fetch Materials Button -->
@* <button id="filterButton" class="btn btn-primary mt-2">Fetch Materials</button> *@

<!-- Display Materials Grouped by Teacher -->
<div id="materialsContainer" class="mt-3"></div>

<!-- jQuery and Kendo UI for AJAX Filtering -->
<script>
   $(document).ready(function () {
    if (typeof jQuery === "undefined") {
        console.error("jQuery is not loaded!");
        return;
    }

    console.log("jQuery version:", $.fn.jquery);

    $("#subjectDropdown").kendoMultiSelect({
        placeholder: "Select subjects..."
    });

    function updateMaterials() {
        var selectedSubjects = $("#subjectDropdown").data("kendoMultiSelect").value();
        $.ajax({
            url: '@Url.Action("FilterMaterials", "StudentDashboard")',
            type: "POST",
            data: { subjectIds: selectedSubjects },
            success: function (data) {
                $("#materialsContainer").html(data);
            },
            error: function () {
                alert("Error fetching materials.");
            }
        });
    }

    @* $("#filterButton").click(function () {
        updateMaterials();
    }); *@

    $("#subjectDropdown").on("change", function () {
        updateMaterials();
    });
});

</script>
