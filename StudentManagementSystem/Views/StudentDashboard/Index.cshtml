@{
    ViewData["Title"] = "Student Dashboard";
    Layout = "../Shared/_StudentDashboardLayout.cshtml";
}



<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div id="studentProfileCard" class="k-card k-card-flat">
    <div class="k-card-body">
        <div class="profile-header">
            <img id="studentProfilePic" class="profile-pic" src="" alt="Profile Picture">
            <h3 id="studentName" class="k-text-primary"></h3>
            <p id="studentStatus" class="k-text-secondary"></p>
        </div>

        <div id="profileDetails" class="k-grid k-grid-md">
            <div class="k-row">
                <div class="k-col-md-6"><strong>ID:</strong></div>
                <div class="k-col-md-6" id="studentId"></div>
            </div>
            <div class="k-row">
                <div class="k-col-md-6"><strong>Email:</strong></div>
                <div class="k-col-md-6" id="studentEmail"></div>
            </div>
            <div class="k-row">
                <div class="k-col-md-6"><strong>Phone:</strong></div>
                <div class="k-col-md-6" id="studentPhone"></div>
            </div>
            <div class="k-row">
                <div class="k-col-md-6"><strong>Gender:</strong></div>
                <div class="k-col-md-6" id="studentGender"></div>
            </div>
            <div class="k-row">
                <div class="k-col-md-6"><strong>Date of Birth:</strong></div>
                <div class="k-col-md-6" id="studentDOB"></div>
            </div>
            <div class="k-row">
                <div class="k-col-md-6"><strong>Enrollment Date:</strong></div>
                <div class="k-col-md-6" id="studentEnrollDate"></div>
            </div>
        </div>

        <button id="editProfileBtn" class="k-button k-primary">Edit Profile</button>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Fetch student data from session storage
        let studentData = sessionStorage.getItem("Student");

        if (studentData) {
            studentData = JSON.parse(studentData);

            $("#studentId").text(studentData.c_studentId);
            $("#studentName").text(studentData.c_studentName);
            $("#studentEmail").text(studentData.c_studentEmail);
            $("#studentPhone").text(studentData.c_studentPhone);
            $("#studentGender").text(studentData.c_studentGender);
            $("#studentDOB").text(new Date(studentData.c_studentDOB).toLocaleDateString());
            $("#studentEnrollDate").text(new Date(studentData.c_studentEnrollDate).toLocaleDateString());
            $("#studentStatus").text(studentData.c_studentStatus);

            // Profile image fallback
            let profileImg = studentData.c_studentProfile || "default-profile.png";
            $("#studentProfilePic").attr("src", profileImg);
        } else {
            kendo.alert("No student data found in session storage.");
        }

        // Kendo Button Click Event
       $("#editProfileBtn").kendoButton({
    click: function () {
        Swal.fire({
            title: "Edit Profile",
            text: "Edit profile feature coming soon!",
            icon: "info",
            confirmButtonText: "OK"
        });
    }
});
    });
</script>

<style>
    .k-card {
        max-width: 500px;
        margin: 20px auto;
        padding: 20px;
        text-align: center;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        border-radius: 10px;
    }
    .profile-header {
        margin-bottom: 20px;
    }
    .profile-pic {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #0073e6;
        box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
    }
    .k-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #ddd;
    }
    .k-row:last-child {
        border-bottom: none;
    }
</style>
