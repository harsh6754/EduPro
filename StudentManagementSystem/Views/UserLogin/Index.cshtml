@{
    ViewData["Title"] = "Login";
    Layout = "../Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center align-items-center vh-70 bg-light">
    <div class="card shadow-lg p-4" style="width: 380px; border-radius: 12px;">
        <div class="text-center">
            <h3 class="fw-bold mb-3">Welcome Back!</h3>
            <p class="text-muted">Please login to your account</p>
        </div>
        <form id="loginform" method="post">
            @Html.AntiForgeryToken() <!-- CSRF Token -->
            <div id="login-container"></div> <!-- Kendo UI Form will be rendered here -->
        </form>
    </div>
</div>

<div id="validation-success"></div>

<style>
    .container {
    width: 100%;
    max-width: 400px; /* Adjust width */
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
    margin: auto;
}

.k-textbox,
.k-dropdown {
    width: 90% !important; /* Ensure elements take full width */
}

</style>

@section Scripts {
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2021.2.616/styles/kendo.common.min.css" />
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2021.2.616/styles/kendo.default.min.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2021.2.616/js/kendo.all.min.js"></script>

    <script>
    $(document).ready(function () {
        const validationSuccess = $("#validation-success").kendoNotification({
            stacking: "down",
            autoHideAfter: 3000
        }).data("kendoNotification");

        $("#login-container").kendoForm({
            formData: {
                c_StudentEmail: "",
                c_password: "",
                c_role: "Admin"
            },
            validatable: {
                validateOnBlur: true,
                validationSummary: false,
                errorTemplate: "<span class='k-form-error'>#:message#</span>"
            },
            items: [
                {
                    field: "c_StudentEmail",
                    label: "Email Address:",
                    validation: {
                        required: { message: "Please enter your email address." },
                        email: { message: "Please enter a valid email address." }
                    },
                    editor: function (container, options) {
                        $('<input type="email" id="Email" name="c_StudentEmail" class="k-textbox" placeholder="Enter your email" />')
                            .appendTo(container)
                            .kendoTextBox();
                    }
                },
                {
                    field: "c_password",
                    label: "Password:",
                    validation: { required: { message: "Please enter your password." } },
                    editor: function (container, options) {
                        $('<input type="password" id="Password" name="c_password" class="k-textbox w-100" placeholder="Enter your password" />')
                            .appendTo(container)
                            .kendoTextBox();
                    }
                },
                {
                    field: "c_role",
                    label: "Role:",
                    editor: function (container, options) {
                        $('<select id="Role" name="c_role" class="k-dropdown w-100"></select>')
                            .appendTo(container)
                            .kendoDropDownList({
                                dataSource: ["Admin", "Student", "Teacher"],
                                value: "Admin"
                            });
                    }
                }
            ],
            buttonsTemplate: `
                <div class="d-flex flex-row gap-3 mt-3" style="justify-content: space-between; k-button-lg">
                    <button type="submit" class="k-button k-button-lg k-button-solid-primary w-100">Login</button>
                    <button type="button" id="clear-btn" class="k-button k-button-lg k-button-outline-base w-100">Clear</button>
                </div>
            `
        });

        // Handle form submission
        $("#loginform").on("submit", function (e) {
            e.preventDefault();

            let email = $("#Email").val();
            let password = $("#Password").val();
            let role = $("#Role").val();

            let loginUrl = "/UserLogin/AdminLogin";
            if (role === "Student") loginUrl = "/UserLogin/CommonLogin";
            else if (role === "Teacher") loginUrl = "/UserLogin/TeacherLogin";

            if (email === "admin@admin.com" && password === "123456789" && role === "Admin") {
                validationSuccess.show("Login successful!", "success");
                setTimeout(() => { window.location.href = "/Student/Index"; }, 1500);
                return;
            }

            var LoginData = $(this).serialize();

            $.ajax({
                url: loginUrl,
                method: "POST",
                headers: { "RequestVerificationToken": $('input[name="__RequestVerificationToken"]').val() },
                data: LoginData,
                success: function (result) {
                    if (result.success) {
                        validationSuccess.show("Login successful!", "success");
                        setTimeout(() => { window.location.href = "/Home/Index"; }, 1500);
                    } else {
                        validationSuccess.show(result.message, "error");
                    }
                },
                error: function () {
                    validationSuccess.show("Something went wrong. Please try again.", "error");
                }
            });
        });

        // Clear form fields on button click
        $("#clear-btn").on("click", function () {
            $("#Email, #Password").val("");
            $("#Role").data("kendoDropDownList").value("Admin");
            validationSuccess.hide();
        });
    });
    </script>
}
