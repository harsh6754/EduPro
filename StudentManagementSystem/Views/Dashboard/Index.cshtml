@{
    ViewBag.Title = "Teacher Dashboard";
    Layout = "~/Views/Shared/_TeacherDashboardLayout.cshtml";
}

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }

        .dashboard-container {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .card {
            padding: 20px;
            background: #f8f9fa;
            border-radius: 8px;
            box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
        }

        .k-card {
            width: 220px;
            padding: 20px;
            background: #f8f9fa;
            border-radius: 8px;
            box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
            margin: 10px;
            text-align: center;
        }

        .card-header {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .card-body {
            font-size: 14px;
            color: #555;
        }

        .card-container {
            display: flex;
            flex-wrap: wrap;
        }
        .blur-box {
    width: 200px;
    height: 120px;
    background: rgba(255, 255, 255, 0.2); /* Light blur effect */
    backdrop-filter: blur(10px);
    border-radius: 12px;
    box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #333;
    font-weight: bold;
    font-size: 18px;
    margin: 20px auto;
    padding: 20px;
}
.blur-box {
    width: 220px;
    height: 120px;
    background: rgba(255, 255, 255, 0.2); /* Light blur effect */
    backdrop-filter: blur(10px);
    border-radius: 12px;
    box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #333;
    font-weight: bold;
    font-size: 18px;
    margin: 20px auto;
    padding: 20px;
}


    </style>

 

    <!-- Navigation -->
    <div id="menu"></div>



    <div class="blur-box">
    <div id="studentCountBox">
        <h2>Loading...</h2>
        <p>Total Students</p>
    </div>
</div>
<div class="blur-box">
    <div id="teacherClassNameBox">
        <h2>Loading...</h2>
        <p>Class Name</p>
    </div>
</div>

    <!-- Dashboard -->
    <div class="dashboard-container">
        <!-- Assigned Students -->
        <div class="card">
            <h3>Assigned Students</h3>
            <div id="students"></div>
        </div>

        <!-- Upcoming Classes -->
        <div class="card">
            <h3>Upcoming Classes</h3>
            <div id="classSchedule"></div>
        </div>

        <!-- Recent Uploads -->
        <div class="card">
            <h3>Recent Uploads</h3>
            <div id="fileManager"></div>
        </div>

        <div id="pdfViewerContainer" style="display: none; margin-top: 20px;">
            <h4>PDF Preview</h4>
            <div id="pdfViewer"></div>
        </div>




      




    </div>
 <div id="timeline"></div>
    

    <!-- Notifications & Alerts -->
    <div id="notifications"></div>

    <script>
        $(document).ready(function () {
            
           

function loadStudentCount() {
    $.ajax({
        url: "/Dashboard/GetStudentCountByTeacher",
        type: "GET",
        success: function (response) {
            if (response.success) {
                $("#studentCountBox").html(`<h2>${response.count}</h2><p>Total Students</p>`);
            } else {
                $("#studentCountBox").html("<p>No students found.</p>");
            }
        },
        error: function (xhr) {
            console.error("Error fetching student count:", xhr.responseText);
            @* $("#studentCountBox").html("<p>Error loading student count.</p>"); *@
        }
    });
}
    loadStudentCount();

function loadTeacherClassName() {
    $.ajax({
        url: "/Dashboard/GetTeacherClassName",
        type: "GET",
        success: function (response) {
            if (response.success) {
                $("#teacherClassNameBox").html(`<h2>${response.className}</h2><p>Class Name</p>`);
            } else {
                $("#teacherClassNameBox").html("<p>No class assigned.</p>");
            }
        },
        error: function (xhr) {
            console.error("Error fetching class name:", xhr.responseText);
            $("#teacherClassNameBox").html("<p>Error loading class name.</p>");
            
        }
    });
}
    loadTeacherClassName();

            function loadStudents() {
                $.ajax({
                    url: "/Dashboard/GetStudentsByTeacher", // Ensure this matches your controller route
                    type: "GET",
                    success: function (response) {
                        if (response.success ) {
                            $("#students").kendoListView({
                                dataSource: {
                                    data: response.data
                                },
                                template: `
                                <div class="k-card">
                                    <div class="card-header">#: c_studentName #</div>
                                    <div class="card-body">Class Name: #: c_classId #</div>
                                </div>
                            `
                            });
                        } else {
                            $("#students").html("<p>No students found.</p>");
                        }
                    },
                    error: function (xhr) {
                        console.error("Error fetching students:", xhr.responseText);
                        @* $("#students").html("<p>Error loading students.</p>"); *@
                    }
                });
            }

            loadStudents();

            function loadUpcomingClasses() {
                $.ajax({
                    url: "/Dashboard/GetUpcomingClasses",
                    type: "GET",
                    success: function (response) {
                        if (response.success) {
                            $("#classSchedule").kendoListView({
                                dataSource: {
                                    data: response.data
                                },
                                template: `
                        <div class="k-card">
                            <div class="card-header">Subject Name: #: SubjectName #</div>
                            <div class="card-body">
                                Time: #: StartTime  # - #: EndTime # <br>
                                Weekday: #: Weekday #
                            </div>
                        </div>
                    `
                            });
                        } else {
                            $("#classSchedule").html("<p>No upcoming classes.</p>");
                        }
                    },
                    error: function (xhr) {
                        console.error("Error fetching classes:", xhr.responseText);
                        @* $("#classSchedule").html("<p>Error loading classes.</p>"); *@
                    }
                });
            }
            loadUpcomingClasses();

            function loadRecentUpload() {
                $.ajax({
                    url: "/Dashboard/GetLatestFile",
                    type: "GET",
                    success: function (response) {
                        console.log("🔹 API Response:", response); // ✅ Debugging log

                        if (response && response.FileName ) {  // ✅ Ensure correct property name
                            console.log("✅ Latest File Found:", response.FileName);

                            var fileHtml = `
                    <div class="k-card">
                        <div class="card-header">Recent Upload</div>
                        <div class="card-body">
                            <p><strong>File Name:</strong> ${response.FileName}</p>
                            <p><strong>Type:</strong> ${response.FileType}</p>
                            <p><strong>Uploaded On:</strong> ${new Date(response.UploadDate).toLocaleString()}</p>
                            <a href="${response.FilePath}" target="_blank">View</a>
                        </div>
                    </div>
                `;

                            $("#fileManager").html(fileHtml);
                        } else {
                            console.log("❌ No file found in API response");
                            $("#fileManager").html("<p>No recent uploads.</p>");
                        }
                    },
                    error: function (xhr) {
                        console.error("⚠️ Error fetching recent uploads:", xhr.responseText);
                        @* $("#fileManager").html("<p>Error loading files.</p>"); *@
                    }
                });
            }
            loadRecentUpload();



           

            // ✅ Real-time Notifications
            $("#notifications").kendoNotification();
            var notify = $("#notifications").data("kendoNotification");
            notify.show("Welcome to Teacher Dashboard!", "info");
        });


         var timelineData = [
            { date: "2024-03-01", title: "Project Kickoff", description: "Initial project meeting and planning." },
            { date: "2024-03-05", title: "Design Phase", description: "UI/UX team started the design process." },
            { date: "2024-03-10", title: "Development Started", description: "Frontend and backend development begins." },
            { date: "2024-03-20", title: "Testing Phase", description: "Quality assurance and bug fixing." },
            { date: "2024-03-30", title: "Project Launch", description: "Deployment and go-live!" }
        ];

        // Initialize Kendo Timeline
        $("#timeline").kendoTimeline({
            dataSource: {
                data: timelineData
            },
            dateField: "date",
            titleField: "title",
            descriptionField: "description",
            orientation: "vertical" // Can be "horizontal" or "vertical"
        });
    
    </script>


