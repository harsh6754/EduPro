@{
    ViewData["Title"] = "Syllabus Page";
    Layout = "~/Views/Shared/_TeacherDashboardLayout.cshtml";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PDF Upload</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
        }

        .container {
            width: 50%;
            margin: auto;
            padding: 30px;
            background: #f8f9fa;
            border-radius: 8px;
            box-shadow: 2px 2px 10px rgba(0, 0, 0, 0.1);
            min-height: 500px;
        }

        label {
            font-weight: bold;
            margin-top: 10px;
            display: block;
        }

        .input-field {
            width: 100%;
            margin-bottom: 15px;
        }

        .k-button {
            width: 100%;
            margin-top: 10px;
        }

        #pdfViewer {
            margin-top: 20px;
            border: 1px solid #ddd;
            padding: 10px;
            text-align: center;
        }
    </style>
</head>

<body>

    <div class="container">
        <h2>Upload PDF Document</h2>

        <form id="uploadForm">
            <label>Upload PDF:</label>
            <input type="file" id="fileUpload" class="input-field" accept=".pdf" required>

            <label>File Name:</label>
            <input id="fileName" class="input-field" readonly>

            <label>File Type:</label>
            <input id="fileType" class="input-field" readonly>

            <label>Upload Date:</label>
            <input id="uploadDate" class="input-field" type="date" required>

            <label>Subject:</label>
            <select id="subjectDropdown" class="input-field" required>
                <option value="">Select Subject...</option>
                <option value="1">Math</option>
                <option value="2">Physics</option>
                <option value="3">Chemistry</option>
                <option value="4">Hindi</option>
                <option value="5">Computer Science</option>
            </select>

            <button type="submit" id="submit" class="k-button">Upload</button>
        </form>

        <!-- ✅ PDF Viewer Area -->
        <div id="pdfViewer">
            <p>No PDF selected for preview.</p>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {

            // ✅ Handle file selection & PDF Preview
            $("#fileUpload").change(function () {
                let file = this.files[0];

                if (file) {
                    $("#fileName").val(file.name);
                    $("#fileType").val(file.name.split('.').pop()); // Extract and display file type

                    // ✅ PDF Preview
                    if (file.type === "application/pdf") {
                        let reader = new FileReader();
                        reader.onload = function (e) {
                            $("#pdfViewer").html(`<iframe src="${e.target.result}" width="100%" height="400px"></iframe>`);
                        };
                        reader.readAsDataURL(file);
                    } else {
                        $("#pdfViewer").html("<p>Preview not available for this file type.</p>");
                    }
                }
            });
