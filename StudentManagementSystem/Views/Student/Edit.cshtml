@model t_Student

@{
    ViewData["Title"] = "Edit Student";
}

<h2>Edit Student</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="c_studentId" />

    <div class="form-group">
        <label asp-for="c_studentName">Name</label>
        <input asp-for="c_studentName" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="c_studentEmail">Email</label>
        <input asp-for="c_studentEmail" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="c_studentPhone">Phone</label>
        <input asp-for="c_studentPhone" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="c_studentDOB">Date of Birth</label>
        <input asp-for="c_studentDOB" type="date" class="form-control" />
    </div>

    <div class="form-group">
        <label asp-for="c_studentGender">Gender</label>
        <select asp-for="c_studentGender" class="form-control">
            <option>Male</option>
            <option>Female</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="c_class.c_className">Class</label>
        <select asp-for="c_class.c_classId" class="form-control">
            <option value="">Select Class</option>
            @foreach (var cls in ViewBag.Classes)
            {
                <option value="@cls.c_classId">@cls.c_className</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label asp-for="c_Section.c_sectionName">Section</label>
        <select asp-for="c_Section.c_sectionId" class="form-control">
            <option value="">Select Section</option>
            @foreach (var sec in ViewBag.Sections)
            {
                <option value="@sec.c_sectionId">@sec.c_sectionName</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label asp-for="c_studentProfile">Profile Picture</label>
        <input type="file" name="profilePicture" class="form-control" />
        <img src="~/student_images/@Model.c_studentProfile" alt="Profile" width="100" height="100" />
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Update</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
