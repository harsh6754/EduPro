@{
    ViewData["Title"] = "Contacts";
    Layout = "../Shared/_Layout.cshtml";
}
<div class="container mt-4">
    <h3>Contacts</h3>
    <button type="button" id="btnadd" class="k-button k-button-lg k-button-solid-info" onclick="addForm()">✚</button>
</div>
<br>
<div id="grid"></div>
<span id="notification"></span>
<div id="myKModal">
    <form id="contactForm"></form>
</div>

<div id="studentCard"></div>

<!-- Data Card Overlay -->
<div id="dataCard" class="data-card">
    <div class="card-content">
        <h4>Loading Data...</h4>
        <button class="k-button k-button-solid-error" onclick="closeDataCard()">✖</button>
    </div>
</div>

<style>
    .grid-container.blurred {
        filter: blur(5px);
        pointer-events: none;
    }
    .data-card {
        display: none;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: white;
        padding: 20px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        z-index: 1001;
        border-radius: 8px;
    }
    .card-content {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .card-content button {
        margin-top: 10px;
    }
</style>



<script>
    $(document).ready(function () {
        buildForm();
        loadWindows();
        loadKendo();
    });

    function loadWindows() {
        $("#myKModal").kendoWindow({
            width: "600px",
            title: "Contact Form",
            visible: false,
            modal: true,
            actions: ["Close"]
        });

        $("#notification").kendoNotification({
            allowHideAfter: 1000,
            width: 300,
            position: {
                pinned: true,
                top: 30,
                right: 30,
            }
        });
    }

     function openDataCard() {
        $("#dataCard").fadeIn();
        $("#grid").addClass("blurred");
    }

    function closeDataCard() {
        $("#dataCard").fadeOut();
        $("#grid").removeClass("blurred");
    }

    function addForm() {
        var form = $("#contactForm").getKendoForm();
        $("#contactForm").data("kendoForm").setOptions({
            formData: {
                StudentId: "0",
                StudentName: "",
                StudentEmail: "",
                StudentMobile: "",
                StudentDOB: "",
                StudentGender: "",
                StudentStatus: "A",
                StudentImage: null,
                StudentClass: "",
                StudentEnrollDate: "",
                StudentSection: "",
            }
        });
        openModal();
    }


    function buildForm() {
        const validationSuccess = $("#validation-success");
        $("#contactForm").kendoForm({
            formData: {
              StudentId: "0",
                StudentName: "",
                StudentEmail: "",
                StudentMobile: "",
                StudentDOB: "",
                StudentGender: "",
                StudentStatus: "A",
                StudentImage: null,
                StudentClass: "",
                StudentEnrollDate: "",
                StudentSection: "",
            },
            items: [
                {
                    field: "ContactId",
                    label: "",
                    editor: function (container, options) {
                        $('<input type="hidden" id="studentid" name="' + options.field + '" value="0" />').appendTo(container);
                    }
                },
                { field: "Name", label: "Name", validation: { required: true } },
                { field: "Email", label: "Email", validation: { required: true, email: true } },
                { field: "Address", label: "Address" },
                { field: "Mobile", label: "Mobile" },
                {
                    field: "Status",
                    label: "Status",
                    editor: "DropDownList",
                    editorOptions: { dataSource: ["Favourate", "Active", "Inactive"], optionLabel: "Select Status" }
                },
                {
                    field: "Group",
                    label: "Group",
                    editor: "MultiSelect",
                    editorOptions: { dataSource: ["Relative", "Friend", "Social", "Professional"], placeholder: "Select Group" }
                },
                {
                    field: "Image",
                    label: "Image:",
                    editor: function (container, options) {
                        $('<input type="file" name="' + options.field + '" />')
                            .appendTo(container)
                            .kendoUpload();
                    }
                },
            ],
            buttonsTemplate: '<button type="submit" class="k-button k-button-lg k-button-solid-info ">Save</button><button class="k-button-solid-base k-button-lg"> Clear</button>',
            validateField: function (e) {
                validationSuccess.html("");
            },
            submit: function (e) {
                e.preventDefault();
                const ContactData = new FormData();
                ContactData.append("c_ContactId", e.model.ContactId);
                ContactData.append("c_UserId", @Context.Session.GetInt32("UserId"));
                ContactData.append("c_Contactname", e.model.Name);
                ContactData.append("c_Email", e.model.Email);
                ContactData.append("c_Address", e.model.Address);
                ContactData.append("c_Mobile", e.model.Mobile);
                ContactData.append("c_Status", e.model.Status);
                ContactData.append("c_Group", e.model.Group.join());
                var imageFile = $("input[name=Image]")[0].files[0];
                if (imageFile) {
                    ContactData.append("ProfilePicture", imageFile);
                }
                $.ajax({
                    url: "/ContactSingle/Create",
                    method: "post",
                    contentType: false,
                    processData: false,
                    data: ContactData,
                    success: function (result) {
                        if (result.success) {
                            $("#notification").getKendoNotification().show(e.model.ContactId == 0 ? "Insert Successfully!!" :
                                "Update Successfully!!", "success");
                            $("#myKModal").data("kendoWindow").close();
                            loadKendo();
                        } else {
                            $("#notification").getKendoNotification().show(result.message, "error");
                            $("#myKModal").data("kendoWindow").close();
                        }
                    },
                    error: function (xhr, status, error) {
                        $("#notification").getKendoNotification().show("Not inserted or updated some error", "error");
                    }
                });
                validationSuccess.html("<div class='k-messagebox k-messagebox-success'>Form data is valid!</div>");
            },
            clear: function (ev) {
                validationSuccess.html("");
            }
        });
    }

    function openModal() {
        $("#myKModal").data("kendoWindow").center().open();
    }

    function closeModal() {
        $("#myKModal").data("kendoWindow").close();
    }

function loadKendo() {
        openDataCard(); // Show the data card overlay when loading starts
        const staticPath = "../../contact_images/";
        $.ajax({
            url: "/Student/GetAllStudents",
            type: 'GET',
            success: function (response) {
                $("#grid").kendoGrid({
                    dataSource: {
                        data: response,
                        schema: {
                            model: {
                                fields: {
                                    c_studentId: { type: "number" },
                                    c_studentName: { type: "string" },
                                    c_studentEmail: { type: "string" },
                                    c_studentPhone: { type: "string" },
                                    c_studentStatus: { type: "string" },
                                    c_class: { type: "object" },
                                    c_section: { type: "object" },
                                    c_studentProfile: { type: "string" }
                                }
                            }
                        },
                        pageSize: 4
                    },
                    height: 400,
                    pageable: true,
                    sortable: true,
                    filterable: true,
                    columns: [
                        {
                            title: "Edit",
                            template: `<button class='k-button k-button-solid-info' onclick='editForm(#=c_studentId#)'>Edit</button>`,
                            width: 50
                        },
                        { field: "c_studentName", title: "Name", width: "150px" },
                        { field: "c_studentEmail", title: "Email", width: "150px" },
                        { field: "c_studentPhone", title: "Phone", width: "120px" },
                        { field: "c_studentStatus", title: "Status", width: "120px" },
                        { field: "c_class.c_className", title: "Class", width: "100px" },
                        { field: "c_section.c_sectionName", title: "Section", width: "100px" },
                        {
                            field: "c_studentProfile", 
                            title: "Profile", 
                            template: `<img src='${staticPath}#=c_studentProfile#' alt='ProfileImage' style='width:50px;height:50px;border-radius:50%;' />`,
                            width: 100
                        },
                        {
                            title: "Delete",
                            template: `<button class='k-button k-button-solid-error' onclick='deleteData(#=c_studentId#,"#=c_studentName#")'>✘</button>`,
                            width: 70
                        }
                    ],
                });
                closeDataCard(); // Hide the data card overlay when loading is complete
            },
            error: function (xhr, status, error) {
                $('#responseMessage').addClass("alert alert-danger");
                $('#responseMessage').text('Error: ' + xhr.responseText);
                closeDataCard();
            }
        });
    }


function displayCard(data) {
    const staticPath = "../../contact_images/";

    $("#studentCard").html(`
        <div class="card" style="border:1px solid #ddd; padding: 15px; width: 300px; border-radius: 10px;">
            <div style="text-align: center;">
                <img src="${staticPath}${data.c_studentProfile}" alt="Profile" style="width: 100px; height: 100px; border-radius: 50%; margin-bottom: 10px;">
            </div>
            <h3 style="text-align: center;">${data.c_studentName}</h3>
            <p><strong>Email:</strong> ${data.c_studentEmail}</p>
            <p><strong>Phone:</strong> ${data.c_studentPhone}</p>
            <p><strong>Status:</strong> ${data.c_studentStatus}</p>
            <p><strong>Class:</strong> ${data.c_class ? data.c_class.c_className : "N/A"}</p>
            <p><strong>Section:</strong> ${data.c_section ? data.c_section.c_sectionName : "N/A"}</p>
        </div>
    `);
}

</script>
