@{
    ViewData["Title"] = "Student List";
    Layout = "../Shared/_Layout.cshtml";
}

<h3>Student Tree and List</h3>

<div id="treeList"></div>
<div id="grid"></div>


@section Scripts {

    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2021.2.616/styles/kendo.common.min.css" />
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2021.2.616/styles/kendo.default.min.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2021.2.616/js/kendo.all.min.js"></script>
<script>
    $(document).ready(function () {
        loadStudents();
    });

    function loadStudents() {
        const staticPath = "../../student_images/";
        $.ajax({
            url: "/Student/Index",
            type: 'GET',
            success: function (response) {
                console.log("Student Data:", response);

                const classGroups = {};
                const treeData = [];

                response.forEach(student => {
                    if (!classGroups[student.c_class.c_classId]) {
                        classGroups[student.c_class.c_classId] = {
                            c_className: student.c_class.c_className,
                            items: []
                        };
                        treeData.push(classGroups[student.c_class.c_classId]);
                    }

                    classGroups[student.c_class.c_classId].items.push({
                        c_ContactName: `${student.c_studentName} - ${student.c_Section.c_sectionName}`
                    });
                });

                $("#treeList").kendoTreeView({
                    dataSource: treeData,
                    dataTextField: "c_className",
                    loadOnDemand: false,
                    expand: function (e) {
                        console.log("Expanded node:", e.node);
                    }
                });

                $("#grid").kendoGrid({
                    dataSource: {
                        data: response,
                        schema: {
                            model: {
                                fields: {
                                    c_studentId: { type: "number" },
                                    c_studentName: { type: "string" },
                                    c_studentEmail: { type: "string" },
                                    c_studentPhone: { type: "string" },
                                    c_class: { type: "object" },
                                    c_Section: { type: "object" },
                                    c_studentEnrollDate: { type: "date" },
                                    c_studentStatus: { type: "string" },
                                    c_studentProfile: { type: "string" }
                                }
                            }
                        },
                        pageSize: 5
                    },
                    height: 500,
                    pageable: true,
                    sortable: true,
                    filterable: true,
                    columns: [
                        { field: "c_studentName", title: "Student Name", width: "150px" },
                        { field: "c_studentEmail", title: "Email", width: "150px" },
                        { field: "c_studentPhone", title: "Phone", width: "120px" },
                        { field: "c_class.c_className", title: "Class", width: "120px" },
                        { field: "c_Section.c_sectionName", title: "Section", width: "120px" },
                        { field: "c_studentEnrollDate", title: "Enroll Date", format: "{0:MM/dd/yyyy}", width: "120px" },
                        { field: "c_studentStatus", title: "Status", width: "100px" },
                        {
                            field: "c_studentProfile",
                            title: "Profile",
                            template: `<img src='${staticPath}#=c_studentProfile#' alt='Profile' style='width:50px;height:50px;border-radius:50%;' />`,
                            width: 100
                        },
                        {
                            title: "Edit",
                            template: `<button class='k-button k-button-lg k-button-solid-info' onclick='editStudent(#=c_studentId#)'>&hellip;</button>`,
                            width: 50
                        },
                        {
                            title: "Delete",
                            template: `<button class='k-button k-button-lg k-button-solid-error' onclick='deleteStudent(#=c_studentId#,"#=c_studentName#")'>✘</button>`,
                            width: 70
                        }
                    ]
                });
            },
            error: function (xhr) {
                console.error("Error loading students:", xhr.responseText);
            }
        });
    }

    function editStudent(studentId) {
        alert("Edit function triggered for Student ID: " + studentId);
    }

    function deleteStudent(studentId, studentName) {
        if (confirm(`Are you sure you want to delete ${studentName}?`)) {
            $.ajax({
                url: `/Student/Delete/${studentId}`,
                type: "DELETE",
                success: function () {
                    alert("Deleted successfully!");
                    loadStudents();
                },
                error: function (xhr) {
                    alert("Error: " + xhr.responseText);
                }
            });
        }
    }
</script>
}