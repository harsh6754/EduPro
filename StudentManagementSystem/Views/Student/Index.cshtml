@{
    ViewData["Title"] = "Contacts";
    Layout = "../Shared/_Layout.cshtml";
}
<div class="container mt-4">
    <h3>Insert Student Records</h3>
    <button type="button" id="btnadd" class="k-button k-button-lg k-button-solid-info" onclick="addForm()">✚</button>
</div>
<br>
<div id="grid"></div>
<span id="notification"></span>
<div id="myKModal">
    <form id="contactForm"></form>
</div>

<div id="studentCard"></div>

<!-- Data Card Overlay -->
<div id="dataCard" class="data-card">
    <div class="card-content">
        <h4>Loading Data...</h4>
        <button class="k-button k-button-solid-error" onclick="closeDataCard()">✖</button>
    </div>
</div>

<style>
    .grid-container.blurred {
        filter: blur(5px);
        pointer-events: none;
    }

    .data-card {
        display: none;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: white;
        padding: 20px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        z-index: 1001;
        border-radius: 8px;
    }

    .card-content {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .card-content button {
        margin-top: 10px;
    }
</style>



<script>
    $(document).ready(function () {
        buildForm();
        loadWindows();
        loadKendo();
    });

    function loadWindows() {
        $("#myKModal").kendoWindow({
            width: "600px",
            title: "Contact Form",
            visible: false,
            modal: true,
            actions: ["Close"]
        });

        $("#notification").kendoNotification({
            allowHideAfter: 1000,
            width: 300,
            position: {
                pinned: true,
                top: 30,
                right: 30,
            }
        });
    }

    function openDataCard() {
        $("#dataCard").fadeIn();
        $("#grid").addClass("blurred");
    }

    function closeDataCard() {
        $("#dataCard").fadeOut();
        $("#grid").removeClass("blurred");
    }

    function addForm() {
        var form = $("#contactForm").getKendoForm();
        $("#contactForm").data("kendoForm").setOptions({
            formData: {
                StudentId: "0",
                StudentName: "",
                StudentEmail: "",
                StudentPassword: "",
                StudentMobile: "",
                StudentDOB: "",
                StudentGuardian: "",
                StudentGender: "",
                StudentStatus: "A",
                StudentImage: null,
                StudentClass: "",
                StudentEnrollDate: "",
                StudentSection: "",
            }
        });
        openModal();
    }


    function buildForm() {
        const validationSuccess = $("#validation-success");

        $("#contactForm").kendoForm({
            formData: {
                StudentId: "0",
                StudentName: "",
                StudentEmail: "",
                StudentPassword: "",
                StudentMobile: "",
                StudentDOB: "",
                StudentGender: "",
                StudentStatus: "",
                StudentImage: null,
                StudentGuardian: "",
                StudentClass: "",
                StudentEnrollDate: "",
                StudentSection: "",
            },
            items: [
                {
                    field: "StudentId",
                    label: "",
                    editor: function (container, options) {
                        $('<input type="hidden" id="studentid" name="' + options.field + '" value="0" />').appendTo(container);
                    }
                },
                {
                    field: "StudentName",
                    label: "Name:",
                    editor: function (container, options) {
                        $('<input type="text" name="' + options.field + '" class="k-textbox" required />').appendTo(container);
                    }
                },
                {
                    field: "StudentEmail",
                    label: "Email:",
                    editor: function (container, options) {
                        $('<input type="email" name="' + options.field + '" class="k-textbox" required />').appendTo(container);
                    }
                },

                {
                    field: "StudentPassword",
                    label: "Password:",
                    editor: function (container, options) {
                        var passwordInput = $('<input type="password" name="' + options.field + '" class="k-textbox" required readonly />');
                        passwordInput.appendTo(container);

                        // Listen for changes in StudentName and StudentMobile
                        $("input[name='StudentName'], input[name='StudentMobile']").on("input", function () {
                            var name = $("input[name='StudentName']").val();
                            var mobile = $("input[name='StudentMobile']").val();
                            var password = generatePassword(name, mobile);
                            passwordInput.val(password);
                        });

                        function generatePassword(name, mobile) {
                            var namePart = name ? name.substring(0, 4) : "abcd"; // First 4 chars or default 'abcd'
                            var mobilePart = mobile ? mobile.slice(-4) : "0000"; // Last 4 digits or default '0000'
                            return namePart + mobilePart;
                        }
                    }
                },
                {
                    field: "StudentGuardian",
                    label: "Guardian:",
                    editor: function (container, options) {
                        $('<input type="text" name="' + options.field + '" class="k-textbox" required />').appendTo(container);
                    }
                },
                {
                    field: "StudentMobile",
                    label: "Mobile:",
                    editor: function (container, options) {
                        $('<input type="text" name="' + options.field + '" class="k-textbox" required />').appendTo(container);
                    }
                },
                {
                    field: "StudentDOB",
                    label: "DOB:",
                    editor: function (container, options) {
                        $('<input name="' + options.field + '" required />')
                            .appendTo(container)
                            .kendoDatePicker({
                                format: "yyyy-MM-dd", // Adjust format as needed
                                value: new Date(),    // Optional: Default to current date
                                max: new Date()       // Prevent selecting future dates
                            });
                    }
                },

                {
                    field: "StudentGender",
                    label: "Gender:",
                    editor: "DropDownList",
                    editorOptions: {
                        dataSource: ["Male", "Female", "Other"],
                        optionLabel: "Select Gender"
                    }
                },
                {
                    field: "StudentStatus",
                    label: "Status",
                    editor: "DropDownList",
                    editorOptions: {
                        dataSource: [
                            { text: "Active", value: "Active" },
                            { text: "Inactive", value: "Inactive" }
                        ],
                        dataTextField: "text",
                        dataValueField: "value",
                        optionLabel: "Select Status"
                    }
                },
                {
                    field: "StudentClass",
                    label: "Class:",
                    editor: "DropDownList",
                    editorOptions: {
                        dataSource: {
                            transport: {
                                read: {
                                    url: "/Student/GetAllClasses", // Update with correct API
                                    dataType: "json"
                                }
                            }
                        },
                        dataTextField: "c_className",
                        dataValueField: "c_classId",
                        optionLabel: "Select Class"
                    }
                },
                {
                    field: "StudentSection",
                    label: "Section:",
                    editor: "DropDownList",
                    editorOptions: {
                        dataSource: {
                            transport: {
                                read: {
                                    url: "/Student/GetAllSections", // Update with correct API
                                    dataType: "json"
                                }
                            }
                        },
                        dataTextField: "c_sectionName",
                        dataValueField: "c_sectionId",
                        optionLabel: "Select Section"
                    }
                },
                {
                    field: "StudentEnrollDate",
                    label: "Enroll Date:",
                    editor: function (container, options) {
                        $('<input name="' + options.field + '" required />')
                            .appendTo(container)
                            .kendoDatePicker({
                                format: "yyyy-MM-dd", // Adjust as per requirement
                                value: new Date(),    // Optional: Default to current date
                            });
                    }
                },

                {
                    field: "StudentImage",
                    label: "Image:",
                    editor: function (container, options) {
                        $('<input type="file" name="' + options.field + '" />')
                            .appendTo(container)
                            .kendoUpload();
                    }
                },
            ],
            buttonsTemplate: '<button type="submit" class="k-button k-button-lg k-button-solid-info">Save</button><button type="reset" class="k-button-solid-base k-button-lg">Clear</button>',
            validateField: function (e) {
                validationSuccess.html("");
            },
            submit: function (e) {
                e.preventDefault();

                const ContactData = new FormData();
                ContactData.append("c_id", e.model.StudentId);
                ContactData.append("c_name", e.model.StudentName);
                ContactData.append("c_email", e.model.StudentEmail);
                ContactData.append("c_password", e.model.StudentPassword);
                ContactData.append("c_mobile_no", e.model.StudentMobile);
                ContactData.append("c_status", e.model.StudentStatus);
                ContactData.append("c_class_id", e.model.StudentClass);
                ContactData.append("c_section_id", e.model.StudentSection);
                ContactData.append("c_gender", e.model.StudentGender);
                ContactData.append("c_dob", e.model.StudentDOB);
                ContactData.append("c_enroll_date", e.model.StudentEnrollDate);
                ContactData.append("c_guardian", e.model.StudentGuardian);

                var imageFile = $("input[name=StudentImage]")[0].files[0];
                if (imageFile) {
                    ContactData.append("ProfilePicture", imageFile);
                }

                $.ajax({
                    url: "/Student/AddStudent",
                    method: "post",
                    contentType: false,
                    processData: false,
                    data: ContactData,
                    success: function (result) {
                        if (result.success) {
                            $("#notification").getKendoNotification().show(
                                e.model.StudentId == "0" ? "Inserted Successfully!!" : "Updated Successfully!!",
                                "success"
                            );
                            $("#myKModal").data("kendoWindow").close();
                            loadKendo();
                        } else {
                            $("#notification").getKendoNotification().show(result.message, "error");
                            $("#myKModal").data("kendoWindow").close();
                        }
                    },
                    error: function () {
                        $("#notification").getKendoNotification().show("Not inserted or updated, some error occurred", "error");
                    }
                });

                validationSuccess.html("<div class='k-messagebox k-messagebox-success'>Form data is valid!</div>");
            },
            clear: function () {
                validationSuccess.html("");
            }
        });
    }


    function openModal() {
        $("#myKModal").data("kendoWindow").center().open();
    }

    function closeModal() {
        $("#myKModal").data("kendoWindow").close();
    }

    function loadKendo() {
        openDataCard(); // Show the data card overlay when loading starts
        const staticPath = "../../contact_images/";
        $.ajax({
            url: "/Student/GetAllStudents",
            type: 'GET',
            success: function (response) {
                $("#grid").kendoGrid({
                    dataSource: {
                        data: response,
                        schema: {
                            model: {
                                fields: {
                                    c_studentId: { type: "number" },
                                    c_studentName: { type: "string" },
                                    c_studentEmail: { type: "string" },
                                    c_studentPhone: { type: "string" },
                                    c_studentStatus: { type: "string" },
                                    c_class: { type: "object" },
                                    c_section: { type: "object" },
                                    c_studentProfile: { type: "string" }
                                }
                            }
                        },
                        pageSize: 4
                    },
                    height: 400,
                    pageable: true,
                    sortable: true,
                    filterable: true,
                    columns: [
                        {
                            title: "Edit",
                            template: `<button class='k-button k-button-solid-info' onclick='editForm(#=c_studentId#)'>Edit</button>`,
                            width: 50
                        },
                        { field: "c_studentName", title: "Name", width: "150px" },
                        { field: "c_studentEmail", title: "Email", width: "150px" },
                        { field: "c_studentPhone", title: "Phone", width: "120px" },
                        { field: "c_studentStatus", title: "Status", width: "120px" },
                        { field: "c_class.c_className", title: "Class", width: "100px" },
                        { field: "c_section.c_sectionName", title: "Section", width: "100px" },
                        {
                            field: "c_studentProfile",
                            title: "Profile",
                            template: `<img src='${staticPath}#=c_studentProfile#' alt='ProfileImage' style='width:50px;height:50px;border-radius:50%;' />`,
                            width: 100
                        },
                        {
                            title: "Delete",
                            template: `<button class='k-button k-button-solid-error' onclick='deleteData(#=c_studentId#,"#=c_studentName#")'>✘</button>`,
                            width: 70
                        }
                    ],
                });
                closeDataCard(); // Hide the data card overlay when loading is complete
            },
            error: function (xhr, status, error) {
                $('#responseMessage').addClass("alert alert-danger");
                $('#responseMessage').text('Error: ' + xhr.responseText);
                closeDataCard();
            }
        });
    }


    function displayCard(data) {
        const staticPath = "../../contact_images/";

        $("#studentCard").html(`
        <div class="card" style="border:1px solid #ddd; padding: 15px; width: 300px; border-radius: 10px;">
            <div style="text-align: center;">
                <img src="${staticPath}${data.c_studentProfile}" alt="Profile" style="width: 100px; height: 100px; border-radius: 50%; margin-bottom: 10px;">
            </div>
            <h3 style="text-align: center;">${data.c_studentName}</h3>
            <p><strong>Email:</strong> ${data.c_studentEmail}</p>
            <p><strong>Phone:</strong> ${data.c_studentPhone}</p>
            <p><strong>Status:</strong> ${data.c_studentStatus}</p>
            <p><strong>Class:</strong> ${data.c_class ? data.c_class.c_className : "N/A"}</p>
            <p><strong>Section:</strong> ${data.c_section ? data.c_section.c_sectionName : "N/A"}</p>
        </div>
    `);
    }

</script>
