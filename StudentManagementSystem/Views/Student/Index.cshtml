@{
    ViewData["Title"] = "Student List";
    Layout = "../Shared/_Layout.cshtml";
}

<h3>Student Tree and List</h3>
<div class="container mt-4">
    <h3>Contacts</h3>
    <button type="button" id="btnadd" class="k-button k-button-lg k-button-solid-info" onclick="addForm()">✚</button>
</div>
<br>
<div id="grid"></div>
<span id="notification"></span>
<div id="treeList"></div>
<div id="myKModal">
    <form id="contactForm"></form>
</div>
<div id="grid"></div>

<!-- Modal for Editing Student Details -->
<div id="editStudentModal">
    <form id="studentForm">
        <input type="hidden" id="studentId" />
        <div class="form-group">
            <label>Name</label>
            <input type="text" id="studentName" class="form-control" />
        </div>
        <div class="form-group">
            <label>Email</label>
            <input type="email" id="studentEmail" class="form-control" />
        </div>
        <div class="form-group">
            <label>Phone</label>
            <input type="text" id="studentPhone" class="form-control" />
        </div>
        <div class="form-group">
            <label>Date of Birth</label>
            <input type="date" id="studentDOB" class="form-control" />
        </div>
        <div class="form-group">
            <label>Gender</label>
            <select id="studentGender" class="form-control">
                <option>Male</option>
                <option>Female</option>
            </select>
        </div>
        <div class="form-group">
            <label>Class</label>
            <select id="studentClass" class="form-control"></select>
        </div>
        <div class="form-group">
            <label>Section</label>
            <select id="studentSection" class="form-control"></select>
        </div>
        <div class="form-group">
            <label>Profile Picture</label>
            <input type="file" id="profilePicture" class="form-control" />
            <img id="studentProfileImg" src="" alt="Profile" width="100" height="100" />
        </div>
        <div class="form-group">
            <button type="button" class="btn btn-primary" onclick="updateStudent()">Update</button>
            <button type="button" class="btn btn-secondary" onclick="closeEditModal()">Cancel</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadStudents();
            loadEditWindow();
        });
        function addForm() {
            var form = $("#studentForm").getKendoForm();
            $("#studentForm").data("kendoForm").setOptions({
                formData: {
                    ContactId: "0",
                    Name: "",
                    Email: "",
                    Address: "",
                    Mobile: "",
                    Status: "A",
                    Group: [],
                    Image: null
                }
            });
            openModal();
        }

        function loadEditWindow() {
            $("#editStudentModal").kendoWindow({
                width: "600px",
                title: "Edit Student",
                visible: false,
                modal: true,
                actions: ["Close"]
            });
        }

        function loadStudents() {
            const staticPath = "../../student_images/";
            $.ajax({
                url: "/Student/StudentList",
                type: 'GET',
                success: function (response) {
                    console.log("Student Data:", response);

                    $("#grid").kendoGrid({
                        dataSource: {
                            data: response,
                            schema: {
                                model: {
                                    fields: {
                                        c_studentId: { type: "number" },
                                        c_studentName: { type: "string" },
                                        c_studentEmail: { type: "string" },
                                        c_studentPhone: { type: "string" },
                                        c_class: { type: "object" },
                                        c_Section: { type: "object" },
                                        c_studentDOB: { type: "date" },
                                        c_studentGender: { type: "string" },
                                        c_studentProfile: { type: "string" }
                                    }
                                }
                            },
                            pageSize: 5
                        },
                        height: 500,
                        pageable: true,
                        sortable: true,
                        filterable: true,
                        columns: [
                            { field: "c_studentName", title: "Student Name", width: "150px" },
                            { field: "c_studentEmail", title: "Email", width: "150px" },
                            { field: "c_studentPhone", title: "Phone", width: "120px" },
                            { field: "c_class.c_className", title: "Class", width: "120px" },
                            { field: "c_Section.c_sectionName", title: "Section", width: "120px" },
                            { field: "c_studentDOB", title: "DOB", format: "{0:MM/dd/yyyy}", width: "120px" },
                            { field: "c_studentGender", title: "Gender", width: "100px" },
                            {
                                field: "c_studentProfile",
                                title: "Profile",
                                template: `<img src='${staticPath}#=c_studentProfile#' alt='Profile' style='width:50px;height:50px;border-radius:50%;' />`,
                                width: 100
                            },
                            {
                                title: "Edit",
                                template: `<button class='k-button k-button-lg k-button-solid-info' onclick='editStudent(#=c_studentId#)'>&hellip;</button>`,
                                width: 50
                            },
                            {
                                title: "Delete",
                                template: `<button class='k-button k-button-lg k-button-solid-error' onclick='deleteStudent(#=c_studentId#,"#=c_studentName#")'>✘</button>`,
                                width: 70
                            }
                        ]
                    });
                },
                error: function (xhr) {
                    console.error("Error loading students:", xhr.responseText);
                }
            });
        }

        function editStudent(studentId) {
            $.ajax({
                url: `/Student/GetOne/${studentId}`,
                type: 'GET',
                success: function (response) {
                    $("#studentId").val(response.c_studentId);
                    $("#studentName").val(response.c_studentName);
                    $("#studentEmail").val(response.c_studentEmail);
                    $("#studentPhone").val(response.c_studentPhone);
                    $("#studentDOB").val(response.c_studentDOB.split('T')[0]);
                    $("#studentGender").val(response.c_studentGender);
                    $("#studentProfileImg").attr("src", "../../student_images/" + response.c_studentProfile);

                    loadClasses(response.c_class.c_classId);
                    loadSections(response.c_Section.c_sectionId);

                    $("#editStudentModal").data("kendoWindow").center().open();
                },
                error: function (xhr) {
                    alert("Error: " + xhr.responseText);
                }
            });
        }

        function loadClasses(selectedClassId) {
            $.ajax({
                url: "/Student/GetClasses",
                type: "GET",
                success: function (data) {
                    let options = "<option value=''>Select Class</option>";
                    data.forEach(cls => {
                        options += `<option value="${cls.c_classId}" ${cls.c_classId === selectedClassId ? "selected" : ""}>${cls.c_className}</option>`;
                    });
                    $("#studentClass").html(options);
                }
            });
        }

        function loadSections(selectedSectionId) {
            $.ajax({
                url: "/Student/GetSections",
                type: "GET",
                success: function (data) {
                    let options = "<option value=''>Select Section</option>";
                    data.forEach(sec => {
                        options += `<option value="${sec.c_sectionId}" ${sec.c_sectionId === selectedSectionId ? "selected" : ""}>${sec.c_sectionName}</option>`;
                    });
                    $("#studentSection").html(options);
                }
            });
        }

        function updateStudent() {
            const formData = new FormData();
            formData.append("c_studentId", $("#studentId").val());
            formData.append("c_studentName", $("#studentName").val());
            formData.append("c_studentEmail", $("#studentEmail").val());
            formData.append("c_studentPhone", $("#studentPhone").val());
            formData.append("c_studentDOB", $("#studentDOB").val());
            formData.append("c_studentGender", $("#studentGender").val());

            $.ajax({
                url: "/Student/Update",
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                success: function () {
                    alert("Student updated successfully!");
                    $("#editStudentModal").data("kendoWindow").close();
                    loadStudents();
                },
                error: function (xhr) {
                    alert("Error updating student: " + xhr.responseText);
                }
            });
        }
        function deleteStudent(studentId, studentName) {
            if (confirm(`Are you sure you want to delete ${studentName} ?`)) {
                $.ajax({
                    url: ` /Student/Delete / ${studentId}`,
                    type: "DELETE",
                    success: function () {
                        alert("Deleted successfully!");
                        loadStudents();
                    },
                    error: function (xhr) {
                        alert("Error: " + xhr.responseText);
                    }
                });
            }
        }
    </script>
}
