@{
    ViewData["Title"] = "Profile";  
    Layout = "~/Views/Shared/_TeacherDashboardLayout.cshtml";
}

<!-- Dependencies -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.2/sweetalert.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/qrcodejs/qrcode.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html5-qrcode/2.3.8/html5-qrcode.min.js"></script>

<!-- Kendo UI CDN -->
<link rel="stylesheet" href="https://kendo.cdn.telerik.com/2024.1.130/styles/kendo.default-v2.min.css">
<script src="https://kendo.cdn.telerik.com/2024.1.130/js/kendo.all.min.js"></script>

<div class="container mt-4">
    <h2 class="text-center mb-4">Teacher Profile</h2>

    <!-- Kendo Splitter -->
    <div id="profileSplitter">
        <div>
            <div class="card shadow-lg h-100">
                <div class="card-header bg-primary text-white">General Information</div>
                <div class="card-body">
                    <p><strong>Teacher ID:</strong> <span id="teacherId"></span></p>
                    <p><strong>Name:</strong> <span id="teacherName"></span></p>
                    <p><strong>Email:</strong> <span id="teacherEmail"></span></p>
                    <p><strong>Mobile:</strong> <span id="teacherMobile"></span></p>
                    <p><strong>Date of Birth:</strong> <span id="teacherDOB"></span></p>
                </div>
            </div>
        </div>

        <div>
            <div class="card shadow-lg h-100">
                <div class="card-header bg-success text-white">Qualification & Experience</div>
                <div class="card-body">
                    <p><strong>Experience:</strong> <span id="teacherExperience"></span> years</p>
                    <p><strong>Qualification:</strong> <span id="teacherQualification"></span></p>
                    <p><strong>Expert Subject:</strong> <span id="teacherExpertSubject"></span></p>
                </div>
            </div>
        </div>

        <div>
            <div class="card shadow-lg h-100">
                <div class="card-header bg-warning text-dark">Class & Subject Information</div>
                <div class="card-body">
                    <p><strong>Class ID:</strong> <span id="teacherClassId"></span></p>
                    <p><strong>Subject ID:</strong> <span id="teacherSubjectId"></span></p>
                </div>
            </div>
        </div>

        <div>
            <div class="card shadow-lg h-100">
                <div class="card-header bg-info text-white">QR Code Generation</div>
                <div class="card-body text-center">
                    <div id="qrcode"></div>
                    <button class="btn btn-dark mt-3" onclick="generateQRCode()">Generate QR Code</button>
                </div>
            </div>
        </div>

        <div>
            <div class="card shadow-lg h-100">
                <div class="card-header bg-danger text-white">QR Code Scanner</div>
                <div class="card-body text-center">
                    <div id="reader" style="width: 100%;height:300px;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#profileSplitter").kendoSplitter({
            orientation: "vertical",
            panes: [
                { collapsible: true, size: "100%" },
                { collapsible: true, size: "100%" },
                { collapsible: true, size: "100%" },
                { collapsible: true, size: "100%" },
                { collapsible: true, size: "100%" }
            ]
        });

        let teacherData = sessionStorage.getItem("Teacher");

        if (teacherData) {
            let teacher = JSON.parse(teacherData);
            document.getElementById("teacherId").innerText = teacher.TeacherId || "N/A";
            document.getElementById("teacherName").innerText = teacher.T_Name || "N/A";
            document.getElementById("teacherEmail").innerText = teacher.T_Email || "N/A";
            document.getElementById("teacherMobile").innerText = teacher.T_MobileNumber || "N/A";
            document.getElementById("teacherDOB").innerText = teacher.T_DateOfBirth ? new Date(teacher.T_DateOfBirth).toLocaleDateString() : "N/A";
            document.getElementById("teacherExperience").innerText = teacher.T_Experience || "N/A";
            document.getElementById("teacherQualification").innerText = teacher.T_Qualification || "N/A";
            document.getElementById("teacherExpertSubject").innerText = teacher.T_ExpertSubject || "N/A";
            document.getElementById("teacherClassId").innerText = teacher.T_Class_Id || "N/A";
            document.getElementById("teacherSubjectId").innerText = teacher.T_SubjectId || "N/A";
        } else {
            console.log("No teacher data found in sessionStorage.");
        }
    });

    function generateQRCode() {
        let teacherData = sessionStorage.getItem("Teacher");

        if (teacherData) {
            let qrcodeDiv = document.getElementById("qrcode");
            qrcodeDiv.innerHTML = "";

            try {
                let qrcodeData = JSON.stringify(JSON.parse(teacherData));

                new QRCode(qrcodeDiv, {
                    text: qrcodeData,
                    width: 150,
                    height: 150
                });

                swal("Success", "QR Code Generated Successfully!", "success");
            } catch (error) {
                console.error("QR Code Generation Error:", error);
                swal("Error", "Failed to generate QR code!", "error");
            }
        } else {
            swal("Error", "No teacher data found in sessionStorage!", "error");
        }
    }

        function onScanSuccess(qrCodeMessage) {
        let teacherData = sessionStorage.getItem("Teacher");

        if (teacherData === qrCodeMessage) {
            swal("Success", "Account verified successfully!", "success");
            $("#reader").hide();
            $("#qrcode").css({ filter: "blur(10px)", pointerEvents: "none" });
        } else {
            swal("Error", "QR Code mismatch!", "error");
        }
    }

    let html5QrcodeScanner = new Html5QrcodeScanner("reader", {
        fps: 10,
        qrbox: { width: 250, height: 250 }  // Adjust size
    });
    html5QrcodeScanner.render(onScanSuccess);
</script>
