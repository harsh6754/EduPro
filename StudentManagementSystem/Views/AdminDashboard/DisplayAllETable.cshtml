@{
    ViewBag.Title = "DisplayAllETable";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}
<style>
    #tcards {
        display: grid;
        grid-template-columns: auto auto auto;
    }
</style>
<h2>All Exam Timetables</h2>
<div id="responsemessage"></div>
<div class="container" id="tcards"></div>
<script>
    $(document).ready(function () {
        loadETables();
    })
    function loadETables() {
        $('#tcards').empty();
        $.ajax({
            url: "/AdminDashboard/GetAllETables",
            type: "GET",
            contentType: false,
            processData: false,
            success: function (response) {
                console.log(response);
                response.forEach((res) => {
                    var card = `<div class="k-card mt-5" style="width: 300px;">
                    <div class="k-card-header">
                        <img src="../../exam_timetable/${res.cImage}" alt="..." style="width: 300px;height:300px; position: relative;right: 17px;">
                    </div>
                    <div class="k-card-body">
                        <p>Class ${res.class.c_className} Exam Timetable</p>
                    </div>
                    <button onclick="deleteETable(${res.cClassId})" class="k-button k-button-lg k-button-solid-error">Delete</button>
                    </div>`
                    $('#tcards').append(card);
                });
            },
            error: function (xhr) {
                console.log(xhr);
                $('#responsemessage').addClass("k-messagebox k-messagebox-error");
                $('#responsemessage').text(xhr.responseText);
            }
        });
    }
    function deleteETable(classId) {
        $.ajax({
            url: `/AdminDashboard/DeletExamTimetable/${classId}`,
            type: "POST",
            contentType: false,
            processData: false,
            success: function (response) {
                console.log(response);
                $('#responsemessage').addClass("k-messagebox k-messagebox-success");
                $('#responsemessage').text("Timetable Deleted successfully!!");
                setTimeout(function () {
                    $('#responsemessage').removeClass("k-messagebox k-messagebox-success");
                    $('#responsemessage').text("");
                }, 2000);
                loadETables();
            },
            error: function (xhr) {
                console.log(xhr);
                $('#responsemessage').addClass("k-messagebox k-messagebox-error");
                $('#responsemessage').text(xhr.responseText);
            }
        });
    }
</script>