@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}

<style>
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #eef2f7;
        color: #333;
    }

    .form-container {
        max-width: 500px;
        margin: 40px auto;
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        font-weight: 500;
    }

    input, select {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 6px;
    }

    .upload-preview {
        margin-top: 10px;
        max-width: 100%;
        border-radius: 6px;
        display: none;
    }

    .btn-container {
        display: flex;
        justify-content: space-between;
    }

    .btn {
        padding: 10px 15px;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.3s;
    }

    .btn-submit {
        background: #28a745;
        color: white;
    }

    .btn-submit:hover {
        background: #218838;
    }

    .btn-clear {
        background: #ffc107;
        color: white;
    }

    .btn-clear:hover {
        background: #e0a800;
    }
</style>

<h2 style="text-align:center;">Edit Timetable</h2>
<div id="validation-success"></div>
<div class="form-container">
    <form id="e-form" enctype="multipart/form-data">
        <div class="form-group">
            <label for="img">Exam Timetable</label>
            <input type="file" id="img" name="Image" required>
            <img id="preview" class="upload-preview" />
        </div>
        <div class="form-group">
            <label for="classes-dropdown">Classes</label>
            <select id="classes-dropdown" name="Classes" required></select>
        </div>
        <div class="btn-container">
            <button type="submit" class="btn btn-submit">Submit</button>
            <button type="reset" class="btn btn-clear">Clear</button>
        </div>
    </form>
</div>

<script>
    $(document).ready(function () {
        const validationSuccess = $('#validation-success');
        loadClasses();

        $('#img').change(function () {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    $('#preview').attr('src', e.target.result).show();
                }
                reader.readAsDataURL(file);
            }
        });

        $('#e-form').submit(function (e) {
            e.preventDefault();
            const formData = new FormData(this);

            $.ajax({
                url: "/AdminDashboard/Update",
                type: "POST",
                data: formData,
                contentType: false,
                processData: false,
                success: function (response) {
                    if (response.success) {
                        window.location.href = "/AdminDashboard/DisplayAllETable";
                    } else {
                        validationSuccess.html(`<div class='k-messagebox k-messagebox-error'><p>${response.message}</p></div>`);
                    }
                },
                error: function (xhr) {
                    validationSuccess.html(`<div class='k-messagebox k-messagebox-error'>${xhr.responseText}</div>`);
                }
            });
        });

        function loadClasses() {
            $.ajax({
                url: "/AdminDashboard/GetClasses",
                type: "GET",
                success: function (response) {
                    let dropdown = $('#classes-dropdown');
                    dropdown.empty().append('<option value="">Select Class</option>');
                    response.forEach(classItem => {
                        dropdown.append(`<option value="${classItem.c_classId}">${classItem.c_className}</option>`);
                    });
                },
                error: function (xhr) {
                    validationSuccess.html(`<div class='k-messagebox k-messagebox-error'>${xhr.responseText}</div>`);
                }
            });
        }
    });
</script>
