@{
    ViewBag.Title = "Add Exam Timetable";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}
<h2>Upload Timetable</h2>
<div id="validation-success"></div>
<div class="container mt-5">
    <form id="e-form"></form>
</div>

<script>
    $(document).ready(function () {
        const validationSuccess = $('#validation-success');
        loadClasses();

        $("#e-form").kendoForm({
            validateable: {
                validateOnBlur: true,
                validationSummary: false,
                errorTemplate: '<span class="k-error"></span>'
            },
            items: [
                {
                    field: "Image",
                    label: "Exam Timetable",
                    validation: "Please upload the Timetable",
                    editor: function (container, options) {
                        $('<input type="file" id="img" name="' + options.field + '" required/>')
                            .appendTo(container)
                            .kendoTextBox();
                    }
                },
                {
                    field: "Classes",
                    label: "Classes",
                    validation: "Please select the class",
                    editor: function (container, options) {
                        $('<input id="classes-dropdown" name="' + options.field + '" required/>')
                            .appendTo(container)
                            .kendoDropDownList({
                                optionLabel: "Select Class",
                                dataSource: [],
                                dataTextField: "text",
                                dataValueField: "value",
                                filter: "contains"
                            });
                    }
                }
            ],
            buttonsTemplate: '<button type="submit" class="k-button k-button-lg k-button-solid-success">Submit</button>' +
                '<button type="reset" class="k-button k-button-lg k-button-solid-warning">Clear</button>',
            validateField: function () {
                validationSuccess.html('');
            },
            submit: function (e) {
                e.preventDefault();
                const formData = new FormData();
                var fileInput = $('#img')[0].files[0];
                var selectedClass = $("#classes-dropdown").data("kendoDropDownList").value();

                if (fileInput) {
                    formData.append("Image", fileInput);
                }
                if (selectedClass) {
                    formData.append("CClassId", selectedClass);
                }

                $.ajax({
                    url: "/AdminDashboard/Add",
                    type: "POST",
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        console.log(response);
                        if (response.success) {
                            window.location.href = "/AdminDashboard/DisplayAllETable";
                        } else {
                            validationSuccess.html("<div class='k-messagebox k-messagebox-error'><p>" + response.message + "</p></div>");
                        }
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr);
                        var errors = JSON.stringify(xhr.responseText);
                        validationSuccess.html(`<div class='k-messagebox k-messagebox-error'>${errors}</div>`);
                    }
                });
            },
            clear: function () {
                validationSuccess.html("");
                $('#img').val('');
                $("#classes-dropdown").data("kendoDropDownList").value("");
            }
        });

        function loadClasses() {
            $.ajax({
                url: "/AdminDashboard/GetClasses",
                type: "GET",
                success: function (response) {
                    console.log(response);
                    var dropdown = $("#classes-dropdown").data("kendoDropDownList");
                    dropdown.setDataSource({
                        data: response.map(c => ({ text: c.c_className, value: c.c_classId }))
                    });
                },
                error: function (xhr) {
                    console.log(xhr);
                    validationSuccess.html(`<div class='k-messagebox k-messagebox-error'>${xhr.responseText}</div>`);
                }
            });
        }

    });
</script>
