@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}

<div class="row">
    <h1>Teachers Details</h1>
    <div id="treeGrid"></div>
</div>

<div class="row mt-4">
    <h2>Students of Selected Teacher</h2>
    <div id="studentsGrid"></div>
</div>

<div class="row mt-4">
    <h2>Students Per Teacher Chart</h2>
    <div id="studentsChart"></div>
</div>

<script>
    $(document).ready(function () {
        loadTeachersWithStudents();
    });

    function loadTeachersWithStudents() {
        $.ajax({
            url: "/AdminDashboard/GetTeachersWithStudents",
            type: 'GET',
            success: function (response) {
                console.log("Data:", response);

                let treeListData = [];
                let studentData = [];
                let teacherStudentCount = [];

                response.forEach(teacher => {
                    let studentCount = 0;
                    
                    treeListData.push({
                        id: teacher.Id,
                        name: teacher.Text,
                        parentId: null // Root Node
                    });

                    if (teacher.Items && teacher.Items.length > 0) {
                        studentCount = teacher.Items.length;

                        teacher.Items.forEach(student => {
                            treeListData.push({
                                id: student.Id,
                                name: student.Text,
                                parentId: teacher.Id // Nested under teacher
                            });

                            studentData.push({
                                teacherId: teacher.Id,
                                studentId: student.Id,
                                studentName: student.Text
                            });
                        });
                    }

                    teacherStudentCount.push({
                        teacherId: teacher.Id,
                        teacherName: teacher.Text,
                        studentCount: studentCount
                    });
                });

                // Initialize Kendo TreeList
                $("#treeGrid").kendoTreeList({
                    dataSource: {
                        data: treeListData,
                        schema: {
                            model: {
                                id: "id",
                                parentId: "parentId",
                                fields: {
                                    id: { type: "number" },
                                    parentId: { nullable: true },
                                    name: { type: "string" }
                                }
                            }
                        }
                    },
                    height: 500,
                    columns: [
                        { field: "id", title: "ID", width: 100 },
                        { field: "name", title: "Name", width: 300 }
                    ],
                    selectable: "row",
                    change: function (e) {
                        let selectedRow = this.select();
                        let selectedItem = this.dataItem(selectedRow);

                        if (selectedItem && !selectedItem.parentId) { // Check if it's a teacher
                            loadStudentGrid(selectedItem.id, studentData);
                        }
                    }
                });

                // Initialize empty student grid
                $("#studentsGrid").kendoGrid({
                    dataSource: {
                        data: [],
                        schema: {
                            model: {
                                fields: {
                                    studentId: { type: "number" },
                                    studentName: { type: "string" }
                                }
                            }
                        }
                    },
                    height: 300,
                    columns: [
                        { field: "studentId", title: "Student ID", width: 100 },
                        { field: "studentName", title: "Student Name", width: 300 }
                    ]
                });

                // Initialize Kendo Chart
                $("#studentsChart").kendoChart({
                    title: {
                        text: "Number of Students per Teacher"
                    },
                    legend: {
                        position: "top"
                    },
                    series: [{
                        type: "bar",
                        data: teacherStudentCount.map(item => item.studentCount),
                        name: "Students Count"
                    }],
                    categoryAxis: {
                        categories: teacherStudentCount.map(item => item.teacherName),
                        title: {
                            text: "Teachers"
                        }
                    },
                    valueAxis: {
                        title: {
                            text: "Number of Students"
                        }
                    },
                    tooltip: {
                        visible: true,
                        format: "{0} students"
                    }
                });

            },
            error: function (xhr) {
                console.error("Error loading data:", xhr.responseText);
            }
        });
    }

    function loadStudentGrid(teacherId, studentData) {
        let filteredStudents = studentData.filter(student => student.teacherId === teacherId);

        let grid = $("#studentsGrid").data("kendoGrid");
        grid.dataSource.data(filteredStudents);
    }
</script>
