<style>
    /* Global Styles */
    body {
        font-family: 'Poppins', sans-serif;
        background-color: #f4f6f9;
        padding: 20px;
    }

    /* Container for Dropdowns */
    .dropdown-container {
        margin-bottom: 20px;
        max-width: 350px;
    }

    /* Label Styling */
    label {
        font-weight: 600;
        font-size: 15px;
        color: #0056b3;
        margin-bottom: 5px;
        display: block;
    }

    /* Custom Styling for DropDowns */
    .k-dropdown, .form-control {
        font-size: 14px;
        border-radius: 8px !important;
        padding: 12px !important;
        border: 2px solid #007bff !important;
        background: linear-gradient(145deg, #ffffff, #e3e6eb) !important;
        transition: all 0.3s ease-in-out;
        box-shadow: 0px 4px 6px rgba(0, 123, 255, 0.2);
        color: #333 !important;
        width: 100%;
    }

    /* Hover Effect */
    .k-dropdown:hover, .form-control:hover {
        border-color: #0056b3 !important;
        background: #f0f8ff !important;
    }

    /* Focus Effect */
    .k-dropdown:focus, .form-control:focus {
        border-color: #004085 !important;
        box-shadow: 0px 4px 8px rgba(0, 64, 133, 0.4);
        background: white !important;
    }

    /* DropDown Arrow */
    .k-dropdown .k-select {
        background: transparent !important;
        border-left: none !important;
    }

    /* Select Dropdown */
    #sectiondropdown {
        max-width: 350px;
    }

        /* Submit Button Styling */
    #submitBtn {
        font-family: 'Poppins', sans-serif;
        font-size: 16px;
        padding: 12px 20px;
        border-radius: 8px;
        background: #007bff;
        color: white;
        border: none;
        cursor: not-allowed;
        transition: all 0.3s ease-in-out;
        box-shadow: 0px 4px 6px rgba(0, 123, 255, 0.2);
        outline: none;
        width: 100%;
        max-width: 350px;
        display: block;
        margin-top: 10px;
    }

    /* Enabled Button State */
    #submitBtn:enabled {
        cursor: pointer;
        background: #0056b3;
        box-shadow: 0px 4px 8px rgba(0, 64, 133, 0.4);
    }

    /* Hover Effect */
    #submitBtn:hover:enabled {
        background: #004085;
    }

    /* Disabled State */
    #submitBtn:disabled {
        background: #cccccc;
        color: #666;
        cursor: not-allowed;
        box-shadow: none;
    }

</style>

<!-- Dropdowns -->
<form id="selectionForm">
    <div class="dropdown-container">
        <label for="dropdownlist1">Select Class:</label>
        <input id="dropdownlist1" name="classId">
    </div>

    <div class="dropdown-container">
        <label for="dropdownlist2">Select Subject:</label>
        <input id="dropdownlist2" name="subjectId">
    </div>

    <div class="dropdown-container">
        <label for="dropdownlist3">Select Teacher:</label>
        <input id="dropdownlist3" name="teacherId">
    </div>

    <!-- Submit Button -->
    <button id="submitBtn" disabled type="submit">Submit</button>
</form>

<script>
    $(document).ready(function() {
        let classDropdown = $("#dropdownlist1").kendoDropDownList({
            optionLabel: "Select Class",
            dataTextField: "c_className",
            dataValueField: "c_classId",
            dataSource: {
                transport: {
                    read: {
                        url: "getStudentClasses",
                        dataType: "json"
                    }
                }
            },
            change : validateForm
        }).data("kendoDropDownList");

        let subjectDropdown = $("#dropdownlist2").kendoDropDownList({
            optionLabel: "Select Subject",
            dataTextField: "c_subjectname",
            dataValueField: "c_subid",
            dataSource: {
                transport: {
                    read: {
                        url: "getAllSubjects",
                        dataType: "json"
                    }
                }
            },
            change : validateForm
        }).data("kendoDropDownList");

        let teacherDropdown = $("#dropdownlist3").kendoDropDownList({
            optionLabel: "Select Teacher",
            dataTextField: "c_tName",
            dataValueField: "c_tid",
            dataSource: {
                transport: {
                    read: {
                        url: "getAllTeachers",
                        dataType: "json"
                    }
                }
            },
            change : validateForm
        }).data("kendoDropDownList");

        function validateForm() {
            let isValid = classDropdown.value() && subjectDropdown.value() && teacherDropdown.value();
            $("#submitBtn").prop("disabled", !isValid);
        }

        $("#selectionForm").submit(function (event) {
            event.preventDefault(); 

            let formData = new FormData();
            formData.append("c_class_id", classDropdown.value());
            formData.append("c_subject_id", subjectDropdown.value());
            formData.append("c_tid", teacherDropdown.value());

            console.log([...formData]);

            @* $.ajax({
                url: "AssignSubject",  
                type: "POST",
                processData: false, 
                contentType: false, 
                data: formData,
                success: function (response) {
                    alert("Data submitted successfully!");
                },
                error: function (xhr, status, error) {
                    console.error("Error:", error);
                    alert("Failed to submit data.");
                }
            }); *@
        });
    });
</script>

