@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<div id="grid"></div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2021.2.616/js/kendo.all.min.js"></script>
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2021.2.616/styles/kendo.common.min.css" />
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2021.2.616/styles/kendo.default.min.css" />
}

<form id="syllabusForm">
    <div>
        <label for="userDropdown">Select User:</label>
        <input id="userDropdown" name="receiverid" style="width: 100%;" />
    </div>

    <div>
        <label for="title">Notification Title:</label>
        <input type="text" id="title" name="title" class="k-textbox" style="width: 100%;" />
    </div>

    <div>
        <label for="message">Notification Message:</label>
        <textarea id="message" name="message" class="k-textbox" rows="4" style="width: 100%;"></textarea>
    </div>

    <button type="submit" id="sendNotificationBtn" class="k-button k-primary">Send Notification</button>
</form>

<!-- Display Sent Notifications -->
<h2>Sent Notifications</h2>
<div id="notificationGrid"></div>

<script>
    $(document).ready(function () {
        // Load Users into Dropdown
        $("#userDropdown").kendoDropDownList({
            dataTextField: "c_studentName",
            dataValueField: "c_studentId",
            optionLabel: "Select User",
            dataSource: {
                transport: {
                    read: {
                        url: "/Admin/GetAllStudent",
                        dataType: "json"
                    }
                }
            }
        });

        // Initialize Kendo Grid for Sent Notifications
        var notificationGrid = $("#notificationGrid").kendoGrid({
            dataSource: {
                transport: {
                    read: {
                        url: "/GetSentNotifications",
                        dataType: "json"
                    },
                    update: {
                        url: function (data) {
                            return "/UpdateNotification/" + data.Id;
                        },
                        type: "POST",
                        contentType: "application/json",
                        dataType: "json"
                    },
                    destroy: {
                        url: function (data) {
                            return "/DeleteNotification/" + data.Id;
                        },
                        type: "POST",
                        dataType: "json"
                    }
                },
                schema: {
                    model: {
                        id: "Id",
                        fields: {
                            Id: { type: "number", editable: false },
                            ReceiverName: { type: "string", editable: false },
                            Title: { type: "string", editable: true },
                            Message: { type: "string", editable: true }
                        }
                    }
                },
                pageSize: 10
            },
            height: 400,
            pageable: true,
            editable: "inline",
            columns: [
                { field: "Id", title: "ID", width: "50px" },
                { field: "ReceiverName", title: "User", width: "150px" },
                { field: "Title", title: "Title", width: "200px" },
                { field: "Message", title: "Message", width: "300px" },
                {
                    command: [
                        { name: "edit", text: "Edit" },
                        { name: "destroy", text: "Delete" }
                    ],
                    title: "Actions",
                    width: "150px"
                }
            ]
        }).data("kendoGrid");

        // Handle Form Submission with AJAX
        $("#syllabusForm").submit(function (event) {
            event.preventDefault();

            var formData = new FormData();
            var selectedUser = $("#userDropdown").data("kendoDropDownList").text();
            
            formData.append("receiverid", $("#userDropdown").val());
            formData.append("title", $("#title").val());
            formData.append("message", $("#message").val());

            $.ajax({
                url: "/SendNotification",
                type: "POST",
                processData: false,
                contentType: false,
                data: formData,
                success: function (response) {
                    console.log("Response:", response);
                    alert(response.success ? response.message : "Failed to send notification.");
                    
                    // Add the new notification to the grid
                    var newNotification = {
                        Id: response.newId,
                        ReceiverName: selectedUser,
                        Title: $("#title").val(),
                        Message: $("#message").val()
                    };
                    notificationGrid.dataSource.add(newNotification);
                    notificationGrid.dataSource.read(); // Refresh grid

                    // Clear form fields
                    $("#userDropdown").data("kendoDropDownList").value("");
                    $("#title").val("");
                    $("#message").val("");
                },
                error: function (xhr) {
                    console.error("AJAX Error:", xhr.responseText);
                    alert("Error sending notification: " + xhr.responseText);
                }
            });
        });

    });
</script>
