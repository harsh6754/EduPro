@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<div id="grid"></div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://kendo.cdn.telerik.com/2021.2.616/js/kendo.all.min.js"></script>
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2021.2.616/styles/kendo.common.min.css" />
    <link rel="stylesheet" href="https://kendo.cdn.telerik.com/2021.2.616/styles/kendo.default.min.css" />
}

<form id="syllabusForm">
    <div>
        <label for="userDropdown">Select User:</label>
        <input id="userDropdown" name="receiverid" style="width: 100%;" />
    </div>

    <div>
        <label for="title">Notification Title:</label>
        <input type="text" id="title" name="title" class="k-textbox" style="width: 100%;" />
    </div>

    <div>
        <label for="message">Notification Message:</label>
        <textarea id="message" name="message" class="k-textbox" rows="4" style="width: 100%;"></textarea>
    </div>

    <button type="submit" id="sendNotificationBtn" class="k-button k-primary">Send Notification</button>
</form>

<script>
    $(document).ready(function () {
        // Load Users into Dropdown
        $("#userDropdown").kendoDropDownList({
            dataTextField: "c_studentName",
            dataValueField: "c_studentId",
            optionLabel: "Select Class",
            dataSource: {
                transport: {
                    read: {
                        url: "/Admin/GetAllStudent",
                        dataType: "json"
                    }
                }
            }
        });

        // Handle Form Submission with AJAX
        $("#syllabusForm").submit(function (event) {
            event.preventDefault();

            var formData = new FormData();
            formData.append("receiverid", $("#userDropdown").val());
            formData.append("title", $("#title").val());
            formData.append("message", $("#message").val());

            $.ajax({
                url: "/SendNotification",
                type: "POST",
                processData: false,  // Prevent jQuery from processing the data
                contentType: false,   // Let the browser set the content type
                data: formData,
                success: function (response) {
                    console.log("Response:", response);
                    alert(response.success ? response.message : "Failed to send notification.");
                },
                error: function (xhr, status, error) {
                    console.error("AJAX Error:", xhr.responseText);
                    alert("Error sending notification: " + xhr.responseText);
                }
            });
        });

    });
</script>
